# ============================================================
# ERP KEBUMEN — Environment Variables
# Salin file ini menjadi .env lalu isi nilainya.
# Di Hostinger: isi lewat hPanel > Node.js App > Environment Variables
# ============================================================

# Port aplikasi. Hostinger meng-inject PORT otomatis — biarkan default.
PORT=3000

# Mode: development | production
NODE_ENV=production

# ------------------------------------------------------------
# DATABASE
# Default memakai SQLite (file lokal, tanpa server DB tambahan).
# Format:
#   SQLite      -> file:./data/erp.db
#   PostgreSQL  -> postgresql://user:pass@host:5432/dbname
#   MySQL       -> mysql://user:pass@host:3306/dbname
# CATATAN: implementasi aktif saat ini = SQLite (better-sqlite3).
# Lihat README bagian "Migrasi ke PostgreSQL/MySQL".
# ------------------------------------------------------------
DATABASE_URL=file:./data/erp.db

# ------------------------------------------------------------
# KEAMANAN
# Wajib diganti di production. Generate dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ------------------------------------------------------------
JWT_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter
JWT_EXPIRES_IN=12h

# Akun admin awal (dibuat otomatis saat database kosong)
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@kebumen.local
SEED_ADMIN_PASSWORD="Admin#12345"

# ------------------------------------------------------------
# PRESENSI / GEOFENCING
# ------------------------------------------------------------
# Jam masuk standar (HH:mm) untuk kalkulasi keterlambatan
WORK_START=08:00
# Toleransi keterlambatan (menit)
LATE_TOLERANCE_MINUTES=10
# Radius geofence default kantor (meter)
GEOFENCE_RADIUS_M=150
# Akurasi GPS maksimal yang diterima (meter). 0 = nonaktif
MAX_GPS_ACCURACY_M=100
# Folder penyimpanan foto selfie presensi
UPLOAD_DIR=./uploads

# ------------------------------------------------------------
# CORS — kosongkan untuk same-origin (default Hostinger)
# Isi bila frontend dihost terpisah, pisahkan dengan koma.
# ------------------------------------------------------------
CORS_ORIGIN=
